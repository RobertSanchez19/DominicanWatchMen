@page
@model MarcasModel
@{
    ViewData["Title"] = "Marcas";
}

<div class="page-header">
    <h1 class="page-title">Marcas</h1>
</div>

@if (Model.Error is not null)
{
    <div class="error-msg">@Model.Error</div>
}
else if (Model.Marcas.Count == 0)
{
    <div class="empty-msg">Aún no hay marcas registradas.</div>
}
else
{
    <div class="marcas-grid">
        @foreach (var marca in Model.Marcas)
        {
            <!-- Cada marca abre su página de detalle con la información de la casa relojera -->
            <a class="marca-card" href="/MarcaDetalle?id=@marca.Id">
                <!-- Logo guardado o, si no tiene, el favicon de la marca. Si la imagen
                     falla, se muestra la inicial como respaldo. -->
                <img src="@MarcasModel.LogoDe(marca)" alt="@marca.Nombre" class="marca-logo"
                     onerror="this.style.display='none';var s=this.nextElementSibling;if(s){s.style.display='flex';}" />
                <div class="marca-inicial" style="display:none">@(string.IsNullOrEmpty(marca.Nombre) ? "?" : marca.Nombre[..1])</div>
                <div class="marca-info">
                    <h3 class="marca-nombre">@marca.Nombre</h3>
                    <p class="marca-pais">@marca.PaisOrigen</p>
                    <span class="marca-count">@marca.Relojes.Count modelo(s)</span>
                </div>
                <span class="marca-arrow">→</span>
            </a>
        }
    </div>
}
