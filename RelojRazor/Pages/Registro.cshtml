@page
@model RegistroModel
@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="login-wrap">
    <div class="login-card" style="max-width:460px">
        <div class="login-logo">
            <img src="~/favicon.svg" alt="DWM" class="login-logo-icon" width="46" height="46" />
            <div class="login-logo-name">Crear cuenta</div>
            <div class="login-logo-sub">Únete a Dominican Watch Men</div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="login-error">@Model.Error</div>
        }

        <form method="post" class="login-form">
            <div class="form-group">
                <label class="form-label">Nombre</label>
                <input asp-for="Entrada.Nombre" class="form-input" placeholder="Tu nombre" />
                <span asp-validation-for="Entrada.Nombre" class="field-error"></span>
            </div>
            <div class="form-group">
                <label class="form-label">Apellido</label>
                <input asp-for="Entrada.Apellido" class="form-input" placeholder="Tu apellido" />
                <span asp-validation-for="Entrada.Apellido" class="field-error"></span>
            </div>
            <div class="form-group">
                <label class="form-label">Correo electrónico</label>
                <input asp-for="Entrada.Email" class="form-input" placeholder="tucorreo@ejemplo.com" />
                <span asp-validation-for="Entrada.Email" class="field-error"></span>
            </div>
            <div class="form-group">
                <label class="form-label">Contraseña</label>
                <input type="password" asp-for="Entrada.Password" class="form-input" placeholder="Mínimo 8 caracteres" />
                <span asp-validation-for="Entrada.Password" class="field-error"></span>
                <span style="font-size:11px;color:var(--ink-4)">Debe incluir mayúscula, minúscula y número.</span>
            </div>
            <div class="form-group">
                <label class="form-label">Teléfono (opcional)</label>
                <input asp-for="Entrada.Telefono" class="form-input" placeholder="809-000-0000" />
            </div>
            <div class="form-group">
                <label class="form-label">Dirección (opcional)</label>
                <input asp-for="Entrada.Direccion" class="form-input" placeholder="Tu dirección" />
            </div>
            <button type="submit" class="btn-primary login-btn">Crear cuenta</button>
        </form>

        <div class="login-back">
            <span style="font-size:12px;color:var(--ink-4)">¿Ya tienes cuenta? </span>
            <a href="/Login" class="login-back-link">Inicia sesión</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
