@page
@model AdminModel
@{
    ViewData["Title"] = "Administración";
}

<div class="page-header">
    <h1 class="page-title">Administración de Relojes</h1>
    <p class="page-sub">Crea, edita y elimina relojes. Los cambios se guardan en la base de datos a través del Web API.</p>
</div>

@if (Model.Mensaje is not null)
{
    <div class="dwm-alert dwm-alert-ok">@Model.Mensaje</div>
}
@if (Model.Error is not null)
{
    <div class="dwm-alert dwm-alert-err">@Model.Error</div>
}

<!-- ===== FORMULARIO: envia propiedades del .cshtml hacia el .cshtml.cs (Input) ===== -->
<form method="post" class="dwm-form">
    <h2 class="section-title" style="font-size:24px">@(Model.Editando ? "Editar reloj" : "Nuevo reloj")</h2>

    <input type="hidden" asp-for="Input.Id" />
    <input type="hidden" asp-for="Input.ImagenUrl" />

    <div class="dwm-field">
        <label asp-for="Input.Nombre">Nombre</label>
        <input asp-for="Input.Nombre" placeholder="Ej. Explorer Homage" />
        <span asp-validation-for="Input.Nombre" class="field-error"></span>
    </div>

    <div class="dwm-field">
        <label asp-for="Input.Modelo">Modelo</label>
        <input asp-for="Input.Modelo" placeholder="Ej. NH35-EXP-01" />
        <span asp-validation-for="Input.Modelo" class="field-error"></span>
    </div>

    <div class="dwm-field">
        <label asp-for="Input.Precio">Precio (RD$)</label>
        <input asp-for="Input.Precio" type="number" step="0.01" min="0" />
        <span asp-validation-for="Input.Precio" class="field-error"></span>
    </div>

    <div class="dwm-field">
        <label asp-for="Input.Stock">Stock</label>
        <input asp-for="Input.Stock" type="number" min="0" />
        <span asp-validation-for="Input.Stock" class="field-error"></span>
    </div>

    <div class="dwm-field">
        <label asp-for="Input.MarcaId">Marca</label>
        <select asp-for="Input.MarcaId" asp-items="Model.MarcasOpciones">
            <option value="0">— Selecciona una marca —</option>
        </select>
    </div>

    <div class="dwm-field dwm-check">
        <input asp-for="Input.Destacado" type="checkbox" />
        <label asp-for="Input.Destacado" style="margin:0">Mostrar en portada (destacado)</label>
    </div>

    <div class="form-actions">
        <button type="submit" asp-page-handler="Guardar" class="btn-primary">
            @(Model.Editando ? "Guardar cambios" : "Crear reloj")
        </button>
        @if (Model.Editando)
        {
            <a href="/Admin" class="btn-secondary">Cancelar</a>
        }
    </div>
</form>

<!-- ===== LISTADO ===== -->
<div class="page-header" style="background:var(--white);border-top:1px solid var(--border)">
    <h2 class="page-title" style="font-size:26px">Relojes registrados</h2>
</div>

@if (Model.Relojes.Count == 0)
{
    <div class="empty-msg">No hay relojes registrados.</div>
}
else
{
    <table class="dwm-table">
        <thead>
            <tr>
                <th>Imagen</th>
                <th>Nombre</th>
                <th>Modelo</th>
                <th>Marca</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Destacado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var reloj in Model.Relojes)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(reloj.ImagenUrl))
                        {
                            <img src="@reloj.ImagenUrl" alt="@reloj.Nombre" class="dwm-mini-thumb" />
                        }
                        else
                        {
                            <span>⌚</span>
                        }
                    </td>
                    <td>@reloj.Nombre</td>
                    <td>@reloj.Modelo</td>
                    <td>@(reloj.Marca?.Nombre ?? "—")</td>
                    <td>RD$ @reloj.Precio.ToString("N2")</td>
                    <td>@reloj.Stock</td>
                    <td>@(reloj.Destacado ? "★" : "—")</td>
                    <td class="dwm-table-actions">
                        <a href="/Admin?editId=@reloj.Id">Editar</a>
                        <form method="post" asp-page-handler="Eliminar" asp-route-id="@reloj.Id" style="display:inline">
                            <button type="submit" class="danger"
                                    style="background:none;border:none;cursor:pointer;color:#dc2626;font-weight:600;font-size:11px"
                                    onclick="return confirm('¿Eliminar este reloj?');">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
