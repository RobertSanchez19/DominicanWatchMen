@page
@model DetalleModel
@{
    ViewData["Title"] = Model.Reloj?.Nombre ?? "Detalle";
}

@if (Model.Reloj is null)
{
    <div class="page-header">
        <h1 class="page-title">Reloj no disponible</h1>
    </div>
    <div class="error-msg">@Model.Error</div>
    <div style="padding:0 40px 40px"><a class="btn-secondary" href="/Catalogo">← Volver al catálogo</a></div>
}
else
{
    var reloj = Model.Reloj;

    // Componente seleccionado actualmente (para el resumen inicial que ve el usuario).
    var maqSel = reloj.MovimientosCompatibles.FirstOrDefault(m => m.Id == Model.MovimientoId);
    var pulSel = reloj.PulserasCompatibles.FirstOrDefault(p => p.Id == Model.TipoPulseraId);

    var precio = (maqSel is not null && pulSel is not null)
        ? DetalleModel.PrecioUnitario(reloj, maqSel, pulSel) : reloj.Precio;
    var disponible = (maqSel is not null && pulSel is not null)
        ? DetalleModel.Disponibilidad(reloj, maqSel, pulSel) : 0;

    <div class="detalle-top">
        <a class="detalle-volver" href="/Catalogo">← Volver al catálogo</a>
    </div>

    @if (Model.Error is not null)
    {
        <div class="error-msg">@Model.Error</div>
    }

    <div class="detalle-card">
        <!-- ===== IMAGEN ===== -->
        <div class="detalle-img-col">
            <div class="detalle-img-ring"></div>
            @if (!string.IsNullOrEmpty(reloj.ImagenUrl))
            {
                <img src="@reloj.ImagenUrl" alt="@reloj.Nombre" class="detalle-img" />
            }
            else
            {
                <div class="detalle-placeholder">⌚</div>
            }
        </div>

        <!-- ===== CONFIGURADOR ===== -->
        <div class="detalle-cfg">
            <span class="detalle-marca">@(reloj.Marca?.Nombre ?? "Dominican Watch Men")</span>
            <h1 class="detalle-nombre">@reloj.Nombre</h1>
            <p class="detalle-modelo">@reloj.Modelo</p>

            @if (Model.SinOpciones)
            {
                <p class="detalle-sinops">Este reloj aún no tiene máquinas o pulseras configuradas para ensamblar.</p>
            }
            else
            {
                <!-- La seleccion (radios) viaja al PageModel: MovimientoId, TipoPulseraId, Cantidad -->
                <form method="post" asp-page-handler="Agregar" asp-route-id="@reloj.Id"
                      id="configurador"
                      data-base="@reloj.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                      data-basestock="@reloj.Stock">

                    <!-- ===== MAQUINA ===== -->
                    <div class="cfg-grupo">
                        <span class="cfg-label">Máquina</span>
                        <div class="cfg-chips">
                            @foreach (var m in reloj.MovimientosCompatibles)
                            {
                                var agotada = m.Stock <= 0;
                                <label class="cfg-chip @(agotada ? "cfg-chip-off" : "")">
                                    <input type="radio" name="MovimientoId" value="@m.Id"
                                           data-extra="@m.PrecioExtra.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                           data-stock="@m.Stock"
                                           checked="@(m.Id == Model.MovimientoId)" disabled="@agotada"
                                           onchange="dwmConfigurar()" />
                                    <span>@m.Nombre@(m.PrecioExtra > 0 ? $" +{m.PrecioExtra:N0}" : "")@(agotada ? " · agotada" : "")</span>
                                </label>
                            }
                        </div>
                    </div>

                    <!-- ===== PULSERA ===== -->
                    <div class="cfg-grupo">
                        <span class="cfg-label">Pulsera</span>
                        <div class="cfg-chips">
                            @foreach (var p in reloj.PulserasCompatibles)
                            {
                                var agotada = p.Stock <= 0;
                                <label class="cfg-chip @(agotada ? "cfg-chip-off" : "")">
                                    <input type="radio" name="TipoPulseraId" value="@p.Id"
                                           data-extra="@p.PrecioExtra.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                           data-stock="@p.Stock"
                                           checked="@(p.Id == Model.TipoPulseraId)" disabled="@agotada"
                                           onchange="dwmConfigurar()" />
                                    <span>@p.Nombre@(p.PrecioExtra > 0 ? $" +{p.PrecioExtra:N0}" : "")@(agotada ? " · agotada" : "")</span>
                                </label>
                            }
                        </div>
                    </div>

                    <!-- ===== RESUMEN Y ACCION ===== -->
                    <div class="cfg-resumen">
                        <div class="cfg-precio-fila">
                            <span class="cfg-precio" id="cfgPrecio">RD$ @precio.ToString("N2")</span>
                            <span class="cfg-disp" id="cfgDisp">@(disponible > 0 ? $"{disponible} disponibles" : "Agotado")</span>
                        </div>

                        <div class="cfg-cantidad">
                            <label for="cfgCantidad">Cantidad</label>
                            <input type="number" id="cfgCantidad" name="Cantidad" value="1"
                                   min="1" max="@disponible" step="1" />
                        </div>

                        <button type="submit" class="btn-primary cfg-btn" id="cfgBtn"
                                disabled="@(disponible <= 0)">Añadir al carrito</button>
                    </div>
                </form>
            }
        </div>
    </div>
}
